# Copia este archivo a `.env` y rellena los valores.
# `.env` esta en .gitignore: NO lo commitees (contiene tu token).
# Uso:  docker run --env-file .env ...
# ---------------------------------------------------------------------------

# LLaMA-3.2 es un modelo GATED en HuggingFace. Necesitas un token con la
# licencia del modelo ACEPTADA. Genera uno en:
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Opcionales (defaults definidos en tribe_activation_api.py) ---
# TRIBE_MODEL=facebook/tribev2
# TRIBE_CACHE=/cache/tribe
# MAX_UPLOAD_BYTES=524288000
# FALLBACK_TR=1.49
